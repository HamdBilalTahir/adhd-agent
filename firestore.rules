rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner() {
      return isAuth() && resource.data.userId == request.auth.uid;
    }

    function isSupervisor() {
      return isAuth() && resource.data.supervisorId == request.auth.uid;
    }

    // ── /userProfiles/{docId} ─────────────────────────────────────────────────
    match /userProfiles/{docId} {
      allow read:  if isAuth() && (isOwner() || isSupervisor());
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && isOwner();
      allow delete: if false;
    }

    // ── /events/{docId} ───────────────────────────────────────────────────────
    match /events/{docId} {
      allow read:   if isAuth() && (isOwner() || isSupervisor());
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ── /interventions/{docId} ────────────────────────────────────────────────
    match /interventions/{docId} {
      allow read:   if isAuth() && (isOwner() || isSupervisor());
      allow update: if isAuth() && isOwner();
      allow create, delete: if false;
    }

    // ── /alerts/{docId} ───────────────────────────────────────────────────────
    match /alerts/{docId} {
      allow read: if isAuth() && (isOwner() || isSupervisor());
      allow create, update, delete: if false;
    }

    // ── /sessions/{docId} ────────────────────────────────────────────────────
    match /sessions/{docId} {
      allow read, write: if isAuth() && isOwner();
    }

    // ── /activityLogs/{docId} ────────────────────────────────────────────────
    match /activityLogs/{docId} {
      allow read: if isAuth() && isOwner();
      allow create, update, delete: if false;
    }

    // ── /taskBlocks/{docId} ──────────────────────────────────────────────────
    match /taskBlocks/{docId} {
      allow read, create, update: if isAuth() && (
        resource == null
          ? request.resource.data.userId == request.auth.uid
          : isOwner()
      );
      allow delete: if isAuth() && isOwner();
    }

    // ── /relationships/{docId} ───────────────────────────────────────────────
    match /relationships/{docId} {
      allow read: if isAuth() && (
        resource.data.supervisorId == request.auth.uid ||
        resource.data.superviseeId == request.auth.uid
      );
      allow create: if isAuth() && request.resource.data.supervisorId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.supervisorId == request.auth.uid ||
        resource.data.superviseeId == request.auth.uid
      );
      allow delete: if false;
    }

    // ── Deny everything else ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
