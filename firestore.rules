rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Reads the relationships collection to verify the requester is an active
    // supervisor of the given supervisee. The relationship doc ID is the invite
    // code, so we query by field instead.
    // NOTE: this uses get() and will count as an extra read per rule evaluation.
    function isLinkedSupervisor(superviseeId) {
      return isAuth() && exists(
        /databases/$(database)/documents/relationships/$(request.auth.uid + '_' + superviseeId)
      );
    }

    // ── /users/{uid} ──────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if isAuth() && isOwner(userId);

      // Real-time status — linked supervisors may read
      match /status/{docId} {
        allow read: if isAuth() && (isOwner(userId) || isLinkedSupervisor(userId));
        allow write: if isAuth() && isOwner(userId);
      }

      // Append-only event log — linked supervisors may read, no deletes or updates
      match /events/{eventId} {
        allow read:   if isAuth() && (isOwner(userId) || isLinkedSupervisor(userId));
        allow create: if isAuth() && isOwner(userId);
        allow update, delete: if false;
      }

      // Settings — owner only
      match /settings/{docId} {
        allow read, write: if isAuth() && isOwner(userId);
      }
    }

    // ── /relationships/{inviteCode} ───────────────────────────────────────────
    // Either party (supervisor or supervisee) may read their own relationship.
    // Only the supervisor may create. Either party may update (accept / revoke).
    match /relationships/{inviteCode} {
      allow read: if isAuth() && (
        resource.data.supervisorId == request.auth.uid ||
        resource.data.superviseeId == request.auth.uid
      );
      allow create: if isAuth() && request.resource.data.supervisorId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.supervisorId == request.auth.uid ||
        resource.data.superviseeId == request.auth.uid
      );
      allow delete: if false;
    }

    // ── /interventions/{id} ───────────────────────────────────────────────────
    // User may read their own and acknowledge (update respondedAt / response).
    // Linked supervisor may read. Creation and deletion are server-only (Admin SDK).
    match /interventions/{interventionId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        isLinkedSupervisor(resource.data.userId)
      );
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow create, delete: if false;
    }

    // ── /taskBlocks/{id} ─────────────────────────────────────────────────────
    match /taskBlocks/{taskId} {
      allow read:          if isAuth() && resource.data.userId == request.auth.uid;
      allow create:        if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // ── Deny everything else ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
