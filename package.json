{
  "name": "nextjs-boilerplate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prepare": "husky",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "build:extension": "esbuild extension/src/background.ts extension/src/content.ts extension/src/popup.ts --bundle --outdir=extension/dist --target=chrome120 --format=iife",
    "watch:extension": "esbuild extension/src/background.ts extension/src/content.ts extension/src/popup.ts --bundle --outdir=extension/dist --target=chrome120 --format=iife --watch",
    "package:extension": "yarn build:extension && rm -f adhd-agent-extension.zip && zip -r adhd-agent-extension.zip extension/dist/ extension/manifest.json extension/popup.html",
    "deploy:indexes": "firebase deploy --only firestore:indexes",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:firestore": "firebase deploy --only firestore"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "@langchain/core": "^1.1.47",
    "@langchain/google-genai": "^2.1.31",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.10.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.12.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.1.42",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "firebase-tools": "^15.18.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "lint-staged": "^16.3.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.6",
    "typescript": "^5"
  }
}
